<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- net6.0 is the SDK's own target; the EOL notice is not actionable here -->
    <NoWarn>NETSDK1138</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\C2SIMSDK\C2SIMSDK.csproj" />
    <!-- Referenced directly so the ClientLib types (C2SIMClientRESTLib) can be tested.
         C2SIMSDK marks this reference PrivateAssets=all for packaging reasons -->
    <ProjectReference Include="..\C2SIMClientLib\C2SIMClientLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real VRF-captured report fixtures (see TestData/PROVENANCE.md). Copied to the
         test output so tests read them locally and never reach into another repo at runtime -->
    <None Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
